# Copy to .env and fill in.
OPENAI_API_KEY=sk-...

# Where the archive lives. Relative paths resolve against the repo root, so the
# default works if you put the corpus at <repo>/corpus/acme.
ACME_CORPUS_DIR=corpus/acme

# Model pair. TRIAGE is called ~45x per question, SYNTH once.
ACME_TRIAGE_MODEL=gpt-5.4-mini
ACME_SYNTH_MODEL=gpt-5.6-terra

# Concurrency for the triage fan-out.
ACME_TRIAGE_CONCURRENCY=12

# Where the built index and deletion ledger live.
ACME_DATA_DIR=./data
