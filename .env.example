# Copy to .env and fill in.
OPENAI_API_KEY=sk-...

# Where the archive lives.
ACME_CORPUS_DIR=/Users/p/Downloads/corpus/acme

# Model pair. TRIAGE is called ~45x per question, SYNTH once.
ACME_TRIAGE_MODEL=gpt-5-mini
ACME_SYNTH_MODEL=gpt-5

# Concurrency for the triage fan-out.
ACME_TRIAGE_CONCURRENCY=12

# Where the built index and deletion ledger live.
ACME_DATA_DIR=./data
